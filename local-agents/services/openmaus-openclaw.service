[Unit]
Description=openmaus-openclaw for OpenMausBot local-agents
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/david/orca/OpenMausBot
ExecStart=/home/david/orca/OpenMausBot/local-agents/bin/openclaw gateway run
Environment=PATH=/home/david/orca/OpenMausBot/local-agents/openclaw/runtime/tools/node/bin:/home/david/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=360
KillMode=control-group

[Install]
WantedBy=default.target
